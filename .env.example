# ====================================================
#  Sistema RUAH - configuração (este arquivo NÃO vai para o Git)
#  Depois de alterar, feche a janela do sistema e abra de novo.
# ====================================================

PORT=3333
BASE_URL=http://localhost:3333
# Gerada automaticamente pelo INICIAR-RUAH.ps1. Não compartilhe.
SECRET_KEY=

EMPRESA=RUAH Investimentos Imobiliários
CIDADE_PADRAO=Campinas
UF_PADRAO=SP

# Endereço público (túnel) para o proprietário assinar de casa, o cliente abrir o link do imóvel
# e a Meta entregar as mensagens do WhatsApp. Ex.: https://sistema.ruahimobiliaria.com.br
PUBLIC_URL=

# ---------- Google Drive (ver COMO-CONFIGURAR.txt, parte 1) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: ID de uma pasta ou de um Drive compartilhado (Workspace). Vazio = cria "RUAH Imóveis" no Meu Drive.
DRIVE_ROOT_FOLDER_ID=
DRIVE_ROOT_NAME=RUAH Imóveis

# ---------- WhatsApp Cloud API oficial (ver COMO-CONFIGURAR.txt, parte 2) ----------
# Vazio = modo simulado (para testes)
WA_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# ---------- Radar de captação ----------
# WhatsApp da RUAH impresso no QR code das cartas (com DDD). Vazio = celular do corretor responsável.
WHATSAPP_RUAH=
# Custos de referência que aparecem ao pedir aprovação (R$)
CUSTO_MATRICULA=
CUSTO_BIRO=

# ---------- Radar automático (alertas de e-mail dos portais) ----------
# Gmail que recebe os alertas da OLX, ZAP, Viva Real, Imovelweb... (ver COMO-CONFIGURAR.txt, Radar automático)
RADAR_EMAIL=
# Senha de app do Google (16 letras), NÃO a senha normal da conta
RADAR_EMAIL_SENHA=
RADAR_EMAIL_PASTA=INBOX
# De quantos em quantos minutos o sistema confere o e-mail (mínimo 5)
RADAR_INTERVALO_MIN=10
# Avisa no Painel e no Radar se nenhum alerta dos portais chegar nesse número de horas
RADAR_ALERTA_MAX_HORAS=24
# Monitor direto dos portais (lê o mapa de anúncios novos do Chaves na Mão; 0 desliga)
RADAR_PORTAIS=1
RADAR_PORTAIS_MIN=60
# Bairros vigiados, separados por vírgula (vazio = Cambuí, Nova Campinas, Guanabara, Bosque, Taquaral, Barão Geraldo, Alphaville, Swiss Park, Gramado, Sousas, Joaquim Egídio)
RADAR_BAIRROS=

# ---------- IA local (Ollama) ----------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
# desligado | sugerir (IA sugere, corretor aprova) | automatico (IA responde sozinha)
IA_MODO=sugerir
